{
  "name": "team-tracker",
  "version": "1.0.0",
  "description": "Mobile-first project and daily task tracker for a 2-person team, with push notifications and reminders",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:icons": "node scripts/build-icons.js",
    "build:css": "tailwindcss -i src/app.css -o public/app.css --minify",
    "dev:css": "tailwindcss -i src/app.css -o public/app.css --watch",
    "build:ui": "npm run build:icons && npm run build:css",
    "vapid": "web-push generate-vapid-keys"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.50",
    "lucide-static": "^1.61.0",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
