# MongoDB connection string. For both phones to share data, use a cloud database such as MongoDB Atlas (free tier).
MONGODB_URI=mongodb://127.0.0.1:27017/team-tracker

# The two team members' names, separated by a comma.
MEMBERS=Amit,Ashish

# Shared team passcode. Leave it empty to turn the passcode off (only do that for local testing).
APP_PASSCODE=1234

PORT=3000

# Web push keys. Generate a pair with: npm run vapid
# The public key goes to browsers; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret for the reminder cron job. Any long random string.
# The cron job calls: https://YOUR-APP/api/cron/reminders?key=THIS_SECRET
CRON_SECRET=

# Time zone for task times and reminders, and the time of the morning summary (empty = off).
TIME_ZONE=Asia/Kolkata
DIGEST_TIME=09:00
